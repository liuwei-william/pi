    {
      "dot": "cyan",
      "title": "主线三包(P2–P4)",
      "items": [
        "ai:把 20+ 厂商收敛成一套消息模型",
        "agent:把它变成一个 while 循环",
        "coding-agent:把循环变成能用的 CLI"
      ]
    },
    {
      "dot": "violet",
      "title": "关键事实",
      "items": [
        "依赖严格单向,无环",
        "agent 从不构造 HTTP 客户端",
        "接缝窄到只有一个函数类型 StreamFn"
      ]
    },
    {
      "dot": "slate",
      "title": "图上没画的边",
      "items": [
